generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  displayName   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  canvasAccount CanvasAccount?
  tasks         Task[]
  tutorThreads  TutorThread[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CanvasAccount {
  id             String          @id @default(cuid())
  userId         String          @unique
  domain         String
  encryptedToken Bytes
  iv             Bytes
  authTag        Bytes
  label          String?
  canvasUserId   Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastSyncedAt   DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses        Course[]
  conversations  Conversation[]
  events         CalendarEvent[]
  plannerItems   PlannerItem[]
  activityItems  ActivityItem[]

  @@index([domain])
}

model Course {
  id              String          @id @default(cuid())
  canvasAccountId String
  canvasId        Int
  name            String
  courseCode      String?
  term            String?
  startAt         DateTime?
  endAt           DateTime?
  color           String?
  enrollmentState String?
  lastSyncedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  canvasAccount   CanvasAccount   @relation(fields: [canvasAccountId], references: [id], onDelete: Cascade)
  assignments     Assignment[]
  events          CalendarEvent[]
  announcements   Announcement[]
  activityItems   ActivityItem[]
  chunks          CourseChunk[]
  tutorThreads    TutorThread[]

  @@unique([canvasAccountId, canvasId])
  @@index([canvasAccountId])
}

model Assignment {
  id              String    @id @default(cuid())
  courseId        String
  canvasId        Int
  name            String
  htmlUrl         String
  dueAt           DateTime?
  pointsPossible  Float?
  submissionTypes String[]
  hasSubmitted    Boolean   @default(false)
  score           Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([courseId, dueAt])
}

model CalendarEvent {
  id              String        @id @default(cuid())
  canvasAccountId String
  courseId        String?
  canvasId        String
  title           String
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean       @default(false)
  type            String
  htmlUrl         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  canvasAccount   CanvasAccount @relation(fields: [canvasAccountId], references: [id], onDelete: Cascade)
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([canvasAccountId, canvasId])
  @@index([canvasAccountId, startAt])
  @@index([courseId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  canvasId  Int
  title     String
  message   String   @db.Text
  postedAt  DateTime
  htmlUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([courseId, postedAt])
}

model ActivityItem {
  id              String        @id @default(cuid())
  canvasAccountId String
  courseId        String?
  canvasId        String
  type            String
  title           String
  message         String?       @db.Text
  htmlUrl         String?
  createdAt       DateTime
  syncedAt        DateTime      @default(now())
  canvasAccount   CanvasAccount @relation(fields: [canvasAccountId], references: [id], onDelete: Cascade)
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([canvasAccountId, canvasId])
  @@index([canvasAccountId, createdAt])
  @@index([courseId])
}

model Conversation {
  id              String                @id @default(cuid())
  canvasAccountId String
  canvasId        Int
  subject         String
  lastMessageAt   DateTime
  participants    Json
  unread          Boolean               @default(false)
  starred         Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  canvasAccount   CanvasAccount         @relation(fields: [canvasAccountId], references: [id], onDelete: Cascade)
  messages        ConversationMessage[]

  @@unique([canvasAccountId, canvasId])
  @@index([canvasAccountId, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  canvasId       Int
  authorId       Int
  body           String       @db.Text
  createdAt      DateTime
  syncedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, canvasId])
  @@index([conversationId, createdAt])
}

model PlannerItem {
  id              String        @id @default(cuid())
  canvasAccountId String
  plannableType   String
  plannableId     Int
  courseCanvasId  Int?
  title           String
  dueAt           DateTime?
  completed       Boolean       @default(false)
  htmlUrl         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  canvasAccount   CanvasAccount @relation(fields: [canvasAccountId], references: [id], onDelete: Cascade)

  @@unique([canvasAccountId, plannableType, plannableId])
  @@index([canvasAccountId, dueAt])
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  notes     String?   @db.Text
  dueAt     DateTime?
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model TutorThread {
  id        String         @id @default(cuid())
  userId    String
  courseId  String
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages  TutorMessage[]

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
}

model TutorMessage {
  id        String      @id @default(cuid())
  threadId  String
  role      String
  content   String      @db.Text
  citations Json?
  createdAt DateTime    @default(now())
  thread    TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model CourseChunk {
  id         String                      @id @default(cuid())
  courseId   String
  sourceType String
  sourceId   String
  sourceUrl  String
  title      String
  content    String                      @db.Text
  tokenCount Int
  restricted Boolean                     @default(false)
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  course     Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sourceType])
  @@index([courseId, createdAt])
}
